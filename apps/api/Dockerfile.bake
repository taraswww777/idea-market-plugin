# Docker build for Fastify API - single stage from root context
FROM node:20-alpine AS runtime
WORKDIR /app

# Copy tsconfig.base.json from root project directory
COPY /d/ws/my/idea-market-plugin/tsconfig.base.json ./tsconfig.base.json

# Copy all other files from apps/api build context
COPY . .

# Install dependencies
RUN npm install

# Generate Prisma client
RUN npm run generate

# Build TypeScript
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "dist/index.js"]