# Docker build for Fastify API - single stage from root context
FROM node:20-alpine AS runtime
WORKDIR /app

# Copy all files from root project context (includes tsconfig.base.json, package.json, etc.)
COPY . .

# Install dependencies
RUN npm install

# Generate Prisma client
RUN npm run generate

# Build TypeScript
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "dist/index.js"]