generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String   @map("password_hash")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  /// Relation to plugins - a user can have multiple plugins
  plugins       Plugin[] @relation("UserPlugins")
}

model Plugin {
  id              String   @id @default(cuid())
  name            String
  description     String?
  downloadUrl     String
  version         String
  authorId        String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  /// Opposite relation to User.plugins - links back to User
  author          User     @relation("UserPlugins", fields: [authorId], references: [id])
  
  /// GIN-index для полнотекстового поиска по названию
  @@index([name], algorithm: "concurrent")
  
  /// GIN-index для полнотекстового поиска по описанию (использует pg_trgm)
  @@index([description], algorithm: "concurrent", where: { description: { not: null } })
}
