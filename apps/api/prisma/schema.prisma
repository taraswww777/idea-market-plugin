generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plugin {
  id              String   @id @default(cuid())
  name            String
  description     String?
  downloadUrl     String
  version         String
  authorId        String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  author          User     @relation("UserToPlugin", fields: [authorId], references: [id])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String   @map("password_hash")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  plugins       Plugin[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  authorId  String
   
  author    User         @relation("UserToPost", fields: [authorId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
